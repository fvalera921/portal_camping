// Prisma schema — Portal Camping
// Ver agents.md para las reglas de negocio (dinero en céntimos, precios congelados, solapamientos).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TipoParcela {
  TIENDA
  CARAVANA
  AUTOCARAVANA
}

enum Temporada {
  BAJA
  ALTA
}

enum EstadoReserva {
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

model Parcela {
  id                Int       @id @default(autoincrement())
  numero            Int       @unique
  tipo              TipoParcela
  tieneElectricidad Boolean   @default(false)
  notas             String?
  reservas          Reserva[]
}

/** Recurso compartido del camping: solo hay 8 unidades, numeradas 1-8. */
model Frigorifico {
  id       Int       @id @default(autoincrement())
  numero   Int       @unique
  reservas Reserva[]
}

model Reserva {
  id     Int     @id @default(autoincrement())
  parcelaId Int
  parcela   Parcela @relation(fields: [parcelaId], references: [id])

  fechaEntrada DateTime
  fechaSalida  DateTime
  temporada    Temporada

  clienteNombre    String
  clienteDocumento String
  clienteTelefono  String
  clienteEmail     String?
  matricula        String?

  // Frigorifico opcional (a lo sumo 1 por reserva). Su rango de fechas es independiente del de
  // la parcela: por defecto coincide, pero puede ser mas corto. Ver lib/frigorificos.ts.
  frigorificoId           Int?
  frigorifico             Frigorifico? @relation(fields: [frigorificoId], references: [id])
  frigorificoFechaEntrada DateTime?
  frigorificoFechaSalida  DateTime?

  totalCentimos Int
  estado        EstadoReserva @default(CONFIRMADA)

  lineas LineaConcepto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parcelaId, fechaEntrada, fechaSalida])
  @@index([estado, fechaEntrada, fechaSalida])
  @@index([frigorificoId, frigorificoFechaEntrada, frigorificoFechaSalida])
}

model LineaConcepto {
  id        Int     @id @default(autoincrement())
  reservaId Int
  reserva   Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  concepto               String
  cantidad               Int
  precioUnitarioCentimos Int
  subtotalCentimos       Int

  @@index([reservaId])
}

model Tarifa {
  id                 Int    @id @default(autoincrement())
  concepto           String @unique
  precioBajaCentimos Int
  precioAltaCentimos Int
}
